# Suppression file for ASAN/LSAN

# Qt's networkinformation backend caches QDBusMetaObjects that are never released,
# reachable from any QNetworkInformation::loadDefaultBackend() call.
leak:libqnetworkmanager
leak:QDBusMetaObject::createMetaObject
